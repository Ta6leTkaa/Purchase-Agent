ENVIRONMENT=production
STORAGE_BACKEND=database
DATABASE_URL=postgresql+asyncpg://purchase_agent:purchase_agent@localhost:5432/purchase_agent
API_KEY=replace-with-a-long-random-client-value
ADMIN_API_KEY=replace-with-a-long-random-value
APP_DEBUG=false
API_DOCS_ENABLED=false
CORS_ALLOWED_ORIGINS=[]
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=60
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX_CLIENTS=10000
API_PORT=8000
POSTGRES_PORT=5432
TRAIN_PROVIDER_BASE_URL=
TRAIN_PROVIDER_BEARER_TOKEN=
TRAIN_PROVIDER_TIMEOUT_SECONDS=15
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=100
WORKER_CLAIM_TIMEOUT_SECONDS=900
WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
MISSION_WORKER_INSTANCE_ID=mission-worker-1
NOTIFICATION_WORKER_POLL_INTERVAL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=100
NOTIFICATION_CLAIM_TIMEOUT_SECONDS=300
NOTIFICATION_RETRY_INITIAL_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=900
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=5
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_BEARER_TOKEN=
NOTIFICATION_WEBHOOK_SIGNING_SECRET=
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS=10
NOTIFICATION_WORKER_INSTANCE_ID=notification-worker-1
